import os
import time
import requests
import pandas as pd

BASE_URL = "https://api.x.com/2/tweets/search/recent"

def search_recent_posts_to_df(
    bearer_token: str,
    query: str,
    max_pages: int = 200,
    max_results: int = 100,
    sleep_seconds: float = 1.0,
) -> pd.DataFrame:
    """
    Descarga posts (últimos 7 días) que matcheen query, con paginación (next_token).
    Devuelve un DataFrame. Maneja rate limits (429) con backoff exponencial.
    """
    headers = {"Authorization": f"Bearer {bearer_token}"}

    params = {
        "query": query,
        "max_results": max_results,
        "tweet.fields": ",".join([
            "id", "text", "created_at", "author_id", "lang", "geo", "public_metrics"
        ]),
        "expansions": ",".join([
            "author_id",
            "geo.place_id"
        ]),
        "user.fields": ",".join([
            "id", "name", "username", "created_at", "location"
        ]),
        "place.fields": ",".join([
            "id", "full_name", "country", "country_code", "place_type", "geo"
        ]),
        "sort_order": "recency",
    }

    all_rows = []
    next_token = None
    target_rows = max_pages * max_results  # objetivo: 20.000

    for page in range(max_pages):
        if next_token:
            params["next_token"] = next_token
        else:
            params.pop("next_token", None)

        # --- Manejo de rate limits con reintentos ---
        retries = 0
        while True:
            r = requests.get(BASE_URL, headers=headers, params=params, timeout=30)

            if r.status_code == 200:
                break
            elif r.status_code == 429:  # rate limit
                wait = min(60 * (2 ** retries), 900)  # backoff exponencial, máx 15 min
                print(f"[Página {page}] Rate limit. Esperando {wait}s...")
                time.sleep(wait)
                retries += 1
                if retries > 5:
                    raise RuntimeError("Demasiados reintentos por rate limit.")
            else:
                raise RuntimeError(f"X API error {r.status_code}: {r.text}")

        payload = r.json()
        data = payload.get("data", []) or []
        includes = payload.get("includes", {}) or {}
        meta = payload.get("meta", {}) or {}

        users_by_id = {u["id"]: u for u in includes.get("users", []) or []}
        places_by_id = {p["id"]: p for p in includes.get("places", []) or []}

        for t in data:
            author = users_by_id.get(t.get("author_id"), {})
            place_id = (t.get("geo") or {}).get("place_id")
            place = places_by_id.get(place_id, {}) if place_id else {}

            all_rows.append({
                "tweet_id": t.get("id"),
                "created_at": t.get("created_at"),
                "text": t.get("text"),
                "lang": t.get("lang"),
                "author_id": t.get("author_id"),
                "username": author.get("username"),
                "name": author.get("name"),
                "user_location": author.get("location"),  # útil para filtrar US a posteriori
                "place_id": place_id,
                "place_full_name": place.get("full_name"),
                "place_country": place.get("country"),
                "place_country_code": place.get("country_code"),
                "place_type": place.get("place_type"),
                "retweet_count": (t.get("public_metrics") or {}).get("retweet_count"),
                "reply_count": (t.get("public_metrics") or {}).get("reply_count"),
                "like_count": (t.get("public_metrics") or {}).get("like_count"),
                "quote_count": (t.get("public_metrics") or {}).get("quote_count"),
            })

        print(f"[Página {page + 1}/{max_pages}] Acumulados: {len(all_rows)} tweets")

        next_token = meta.get("next_token")
        if not next_token:
            print("No hay más páginas disponibles.")
            break

        if len(all_rows) >= target_rows:
            print(f"Objetivo de {target_rows} alcanzado.")
            break

        time.sleep(sleep_seconds)

    return pd.DataFrame(all_rows)


if __name__ == "__main__":
    token = os.getenv("X_BEARER_TOKEN")
    if not token:
        raise ValueError("Falta X_BEARER_TOKEN en variables de entorno.")

    # Query corregida:
    # - Sin saltos de línea internos
    # - Sin "-goverment" (mal escrito) ni exclusiones que filtran tweets legítimos
    # - Términos ampliados para cubrir nuevas modalidades de fraude financiero
    # - Filtro geo combinado: place_country:US OR idioma inglés
    #   (así capturamos también tweets sin geo activada pero en contexto US)
    query = (
        '('
        'scam OR fraud OR "financial fraud" OR "wire fraud" OR "bank fraud" '
        'OR "investment scam" OR "ponzi scheme" OR embezzlement '
        'OR "securities fraud" OR "crypto scam" OR "romance scam" '
        'OR "phishing scam" OR "pig butchering" OR "rug pull" '
        'OR "fake invoice" OR "IRS scam" OR "tax scam" '
        'OR "zelle scam" OR "venmo scam" OR "cashapp scam"'
        ') '
        '(place_country:US OR lang:en) '
        '-is:retweet -is:reply'
    )

    df = search_recent_posts_to_df(
        bearer_token=token,
        query=query,
        max_pages=200,      # 200 páginas × 100 = 20.000 tweets objetivo
        max_results=100,
        sleep_seconds=1.0
    )

    # Filtrado US a posteriori (opcional, más permisivo que solo place_country:US)
    us_keywords = ["united states", "usa", "u.s.", "us ", "america",
                   "new york", "california", "texas", "florida", "chicago",
                   "los angeles", "boston", "seattle", "miami"]

    def looks_us(row):
        if row.get("place_country_code") == "US":
            return True
        loc = str(row.get("user_location") or "").lower()
        return any(k in loc for k in us_keywords)

    df["likely_us"] = df.apply(looks_us, axis=1)

    df.to_csv("scam_us_recent_posts.csv", index=False, encoding="utf-8")
    print(df.head())
    print(f"Total filas: {len(df)}")
    print(f"Probablemente US: {df['likely_us'].sum()}")
